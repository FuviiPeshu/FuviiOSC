<UserControl x:Class="FuviiOSC.AvatarChanger.UI.AvatarChangerModuleSettingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:common="clr-namespace:FuviiOSC.Common"
    mc:Ignorable="d"
    Loaded="AvatarChangerModuleSettingView_OnLoaded">
    <UserControl.Resources>
        <common:IconKeyToImageConverter x:Key="IconKeyToImage" />
        <common:NonEmptyStringToVisibilityConverter x:Key="IconKeyToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <Border Grid.Row="0" Background="{StaticResource CBackground1}" Height="30" Margin="0 10" />
        
        <ListView Grid.Row="1"
        ItemsSource="{Binding Attribute, Mode=OneWay}"
        AlternationCount="2">
        <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Border
                                Background="{StaticResource CBackground3}"
                                VerticalAlignment="Top">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0"
                                        Width="24" Height="24" Margin="8 4"
                                        Source="{Binding IconKey.Value, Converter={StaticResource IconKeyToImage}}"
                                        Visibility="{Binding IconKey.Value, Converter={StaticResource IconKeyToVisibility}}"
                                        VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                        Margin="8"
                                        Text="{Binding Name.Value, Mode=OneWay}"
                                        Foreground="{StaticResource CForeground2}"
                                        TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                        FontSize="16" FontWeight="Regular" VerticalAlignment="Center" TextAlignment="Left" />
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" FlowDirection="RightToLeft" Margin="8 0">
                                        <Button Style="{StaticResource EditButton}" Width="25" Padding="4" Margin="0 0 4 0" Click="EditInstanceButton_OnClick" Tag="{Binding}" ToolTip="Edit trigger">
                                            <Path Data="M3,17.25V21H6.75L17.81,9.94L14.06,6.19L3,17.25M20.71,7.04C21.1,6.65 21.1,6.02 20.71,5.63L18.37,3.29C17.98,2.9 17.35,2.9 16.96,3.29L15.13,5.12L18.88,8.87L20.71,7.04Z"
                                                  Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                  Stretch="Uniform" />
                                        </Button>
                                        <Button Style="{StaticResource EditButton}" Width="25" Margin="0 0 4 0" Click="DuplicateInstanceButton_OnClick" Tag="{Binding}" ToolTip="Duplicate trigger">
                                            <Canvas Width="14" Height="14">
                                                <Rectangle Canvas.Left="1" Canvas.Top="1" Width="9" Height="9"
                                                           Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                           StrokeThickness="1.5" />
                                                <Rectangle Canvas.Left="4" Canvas.Top="4" Width="9" Height="9"
                                                           Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                           StrokeThickness="1.5" />
                                            </Canvas>
                                        </Button>
                                        <Button Style="{StaticResource RemoveButton}" Margin="0 0 4 0" Click="RemoveInstanceButton_OnClick" Tag="{Binding}" ToolTip="Remove trigger" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ListView.ItemContainerStyle>
        </ListView>
        
        <Border Grid.Row="2" Background="{StaticResource CBackground1}">
            <Button
                Content="Add Trigger"
                Style="{StaticResource AddButton}"
                Click="AddInstanceButton_OnClick" />
        </Border>
    </Grid>
</UserControl>